{
  "prop_templates": {

    "chair_modern_a": {
      "category": "furniture",
      "model": "/resources/props/chair_modern_a.glb",
      "footprint": [{ "dx": 0, "dy": 0 }],
      "anchors": [{ "name": "anchor_sit", "interaction": "sit_chair" }],
      "storage": null
    },

    "fridge_a": {
      "category": "appliance",
      "model": "/resources/props/fridge_a.glb",
      "footprint": [{ "dx": 0, "dy": 0 }, { "dx": 1, "dy": 0 }],
      "anchors": [{ "name": "anchor_open", "interaction": "open_fridge" }],
      "storage": { "slots": 40, "accepted_categories": ["food", "drink"] }
    }
  },

  "item_templates": {

    "plate_stack": {
      "category": "dishware",
      "model": "/resources/items/plate_stack.glb",
      "stackable": true,
      "max_stack": 8,
      "carry_slots": 1,
      "usable_for": ["eat", "serve_food"]
    },

    "vacuum_cleaner": {
      "category": "tool",
      "model": "/resources/items/vacuum.glb",
      "carry_slots": 2,
      "usable_for": ["clean_floor"],
      "animations": { "use": "vacuum_loop" }
    }
  },

  "character_templates": {

    "adult_male_a": {
      "model": "/resources/characters/adult_male_a.glb",
      "base_animations": {
        "idle":  "idle",
        "walk":  "walk",
        "run":   "run",
        "sit":   "sit_idle",
        "sleep": "sleep_loop"
      },
      "inventory_slots": {
        "left_hand": 1,
        "right_hand": 1,
        "back":       1,
        "belt":       4,
        "pockets":    4
      }
    }
  },

  "interaction_templates": {

    "sit_chair": {
      "requires_free_hands": false,
      "animations": {
        "start": ["sit_down_a", "sit_down_b"],
        "loop":  ["sit_idle_a", "sit_idle_b"],
        "stop":  ["stand_up_a"]
      },
      "ik": {},
      "prop_animations": {}
    },

    "open_fridge": {
      "requires_free_hands": 1,
      "animations": {
        "start": ["open_fridge"],
        "loop":  [],
        "stop":  ["close_fridge"]
      },
      "prop_animations": { "start": "door_open", "stop": "door_close" },
      "ik": { "right_hand": "ik_handle" }
    }
  },

  "activity_templates": {

    "eat_meal": {
      "required_items":        ["plate_stack"],
      "required_interaction":  "sit_chair",
      "duration":              1200
    }
  },

